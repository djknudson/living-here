[Unit]
Description=Refresh fishbucket e-ink dashboard every 5 minutes

[Timer]
# Wall-clock schedule: fires at :00, :05, :10 … every 5 min. Unlike a
# OnBootSec+OnUnitActiveSec monotonic pair, an OnCalendar timer always has a
# future elapse, so it re-arms reliably and never gets stuck in `elapsed` state
# after a reboot (which froze the panel once). Persistent=true also fires one
# catch-up run right after boot if a tick was missed while powered off.
OnCalendar=*:0/5
Persistent=true

[Install]
WantedBy=timers.target
